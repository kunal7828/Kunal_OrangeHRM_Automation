        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="DELETE /web/index.php/api/v2/pim/employees/{id}">
          <stringProp name="HTTPSampler.path">/web/index.php/api/v2/pim/employees/${employeeId}</stringProp>
